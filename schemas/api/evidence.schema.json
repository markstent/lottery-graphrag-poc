{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "evidence_type",
    "source_id",
    "source_system",
    "provenance"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "STRUCTURED_RECORD",
        "GRAPH_NODE",
        "GRAPH_RELATIONSHIP",
        "GRAPH_PATH",
        "DERIVED_METRIC",
        "DOCUMENT_CHUNK"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "excerpt": {
      "type": [
        "string",
        "null"
      ]
    },
    "market_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "provenance": {
      "type": "object"
    }
  }
}