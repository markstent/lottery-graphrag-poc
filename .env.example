# Model gateway
MODEL_PROVIDER=ollama
MODEL_NAME=
MODEL_BASE_URL=http://localhost:11434
MODEL_TEMPERATURE=0

# Optional OpenRouter
OPENROUTER_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local default matches docker-compose.yml; override before sharing data anywhere.
NEO4J_PASSWORD=devpassword
NEO4J_DATABASE=neo4j

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semantic_context_lab

# Standard RAG (Phase 8)
DATASET_DIR=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
OLLAMA_HOST=http://localhost:11434
RAG_TOP_K=8
RAG_CONTEXT_TOKEN_BUDGET=2000
RAG_DEDUPE_THRESHOLD=0.85
RAG_RERANK_ENABLED=1
RAG_RERANK_LEXICAL_WEIGHT=0.3
# fake = deterministic CI generator; litellm = ADR-003 gateway
GENERATION_PROVIDER=fake
GENERATION_MODEL=fake-answer-v1
GENERATION_TEMPERATURE=0
GENERATION_API_BASE=

# GraphRAG traversal (Phase 9)
GRAPH_DEPTH=2
GRAPH_MAX_NODES_PER_HOP=100
GRAPH_MAX_EDGES_PER_NODE_TYPE=4
GRAPH_MAX_TOTAL_NODES=200
GRAPH_MAX_EVIDENCE_NODES=12
GRAPH_ONTOLOGY=1

# App
APP_ENV=development
LOG_LEVEL=INFO
