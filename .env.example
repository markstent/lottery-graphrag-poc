# Model gateway
MODEL_PROVIDER=ollama
MODEL_NAME=
MODEL_BASE_URL=http://localhost:11434
MODEL_TEMPERATURE=0

# Optional OpenRouter
OPENROUTER_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local default matches docker-compose.yml; override before sharing data anywhere.
NEO4J_PASSWORD=devpassword
NEO4J_DATABASE=neo4j

# Qdrant
QDRANT_URL=http://localhost:6333

# App
APP_ENV=development
LOG_LEVEL=INFO
