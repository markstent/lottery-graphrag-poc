# Every key below is read by the backend; the values shown are the defaults.
# Keys shown commented out must stay unset (not empty) to get their default.

# Hosted models for official runs: LiteLLM reads this key from the environment
# when GENERATION_MODEL is an openrouter/... model.
OPENROUTER_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local default matches docker-compose.yml; override before sharing data anywhere.
NEO4J_PASSWORD=devpassword
NEO4J_DATABASE=neo4j

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semantic_context_lab

# Retrieval (shared by pipelines A, B and C)
# World to read; unset means <repo>/data/generated/dev-seed2026.
# DATASET_DIR=
# Dense embeddings: ollama (bge-m3) or hashing (the deterministic CI fake).
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
OLLAMA_HOST=http://localhost:11434
# Sparse (BM25) embeddings for hybrid search: fastembed | hashing.
# Unset or empty follows EMBEDDING_PROVIDER: hashing -> hashing, anything else -> fastembed.
SPARSE_PROVIDER=
SPARSE_MODEL=Qdrant/bm25
# Download cache for the fastembed sparse and reranker models.
FASTEMBED_CACHE=~/.cache/fastembed
# Dense and sparse top-k each, fused on the client (RRF, k=60) into the top-k hits.
RAG_TOP_K=40
# One total token budget and one evidence-slot cap for every pipeline.
RAG_CONTEXT_TOKEN_BUDGET=2000
RAG_EVIDENCE_SLOTS=12
# Jaccard overlap at which a document chunk counts as a near-duplicate.
RAG_DEDUPE_THRESHOLD=0.85
# The one judge shared by A, B and C: cross_encoder or lexical (the CI judge).
# Unset means lexical when EMBEDDING_PROVIDER=hashing, else cross_encoder.
# BAAI/bge-reranker-v2-m3 downloads about 2.3 GB on first use (FASTEMBED_CACHE).
RERANK_PROVIDER=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Weight of query-token overlap in the lexical judge (the rest is incoming rank).
RERANK_LEXICAL_WEIGHT=0.3
# fake = deterministic CI generator; litellm = ADR-003 gateway.
GENERATION_PROVIDER=fake
GENERATION_MODEL=fake-answer-v1
GENERATION_TEMPERATURE=0
# Gateway base URL for litellm (for example http://localhost:11434 for Ollama).
# GENERATION_API_BASE=
# Completion cap; room for models that spend tokens on hidden thinking.
GENERATION_MAX_TOKENS=1200

# GraphRAG traversal (pipelines B and C)
GRAPH_DEPTH=2
GRAPH_MAX_NODES_PER_HOP=100
GRAPH_MAX_EDGES_PER_NODE_TYPE=4
GRAPH_MAX_TOTAL_NODES=200
# Base-settings flag for concept expansion; the lab always sets it on for C and off for B,
# so it does not change A/B/C runs.
GRAPH_ONTOLOGY=1
# Records whose validity ended before this ISO date rank as superseded (empty: end of the dataset window).
GRAPH_REFERENCE_DATE=

# Presentation API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Benchmark runs the API publishes (latest run-* directory).
BENCHMARK_DIR=data/evaluation
