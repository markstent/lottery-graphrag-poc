# Model gateway
MODEL_PROVIDER=ollama
MODEL_NAME=
MODEL_BASE_URL=http://localhost:11434
MODEL_TEMPERATURE=0

# Optional OpenRouter
OPENROUTER_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local default matches docker-compose.yml; override before sharing data anywhere.
NEO4J_PASSWORD=devpassword
NEO4J_DATABASE=neo4j

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semantic_context_lab

# Standard RAG (Phase 8)
DATASET_DIR=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# Sparse (BM25) embeddings for hybrid search: fastembed | hashing.
# Unset or empty follows EMBEDDING_PROVIDER: hashing -> hashing (the CI fake),
# anything else -> fastembed.
SPARSE_PROVIDER=
SPARSE_MODEL=Qdrant/bm25
# Model cache for fastembed downloads.
FASTEMBED_CACHE=~/.cache/fastembed
OLLAMA_HOST=http://localhost:11434
# Hybrid search: dense and sparse top-k each, fused (RRF, k=60) on the client into
# the top-k document candidates of every pipeline.
RAG_TOP_K=40
RAG_CONTEXT_TOKEN_BUDGET=2000
RAG_DEDUPE_THRESHOLD=0.85
# Evidence items (graph blocks plus document chunks) every pipeline may use
RAG_EVIDENCE_SLOTS=12
# The one judge shared by A, B and C: cross_encoder (default) or lexical (CI, hashing).
# It scores every candidate it is given against the raw question.
# BAAI/bge-reranker-v2-m3 downloads about 2.3 GB on first use (FASTEMBED_CACHE).
RERANK_PROVIDER=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_LEXICAL_WEIGHT=0.3
# fake = deterministic CI generator; litellm = ADR-003 gateway
GENERATION_PROVIDER=fake
GENERATION_MODEL=fake-answer-v1
GENERATION_TEMPERATURE=0
GENERATION_API_BASE=
# Completion cap; room for models that spend tokens on hidden thinking.
GENERATION_MAX_TOKENS=1200

# GraphRAG traversal (Phase 9)
GRAPH_DEPTH=2
GRAPH_MAX_NODES_PER_HOP=100
GRAPH_MAX_EDGES_PER_NODE_TYPE=4
GRAPH_MAX_TOTAL_NODES=200
GRAPH_ONTOLOGY=1
# Records whose validity ended before this ISO date rank as superseded (empty: end of the dataset window)
GRAPH_REFERENCE_DATE=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Presentation API (Phase 13)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
