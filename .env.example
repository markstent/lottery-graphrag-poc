# Every key below is read by the backend; the values shown are the defaults.
# Keys shown commented out must stay unset (not empty) to get their default.

# Hosted models for official runs: LiteLLM reads this key from the environment
# when GENERATION_MODEL is an openrouter/... model.
OPENROUTER_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local default matches docker-compose.yml; override before sharing data anywhere.
NEO4J_PASSWORD=devpassword
NEO4J_DATABASE=neo4j
# Seconds to connect, and to run one retrieval query (a positive number).
NEO4J_TIMEOUT_S=10

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semantic_context_lab

# Retrieval (shared by pipelines A, B and C)
# World to read; unset means <repo>/data/generated/dev-seed2026.
# DATASET_DIR=
# The truth ledger of that world (evaluator only; unset means <repo>/data/truth/ledger.json).
# The frozen question bank is named after the dataset directory, so the demo world
# (DATASET_DIR=../data/generated/demo-seed2026) needs TRUTH_LEDGER_PATH=../data/truth/ledger-demo.json
# (the backend runs from backend/, so relative paths start with ../, as the Makefile's DEMO_ENV does).
# TRUTH_LEDGER_PATH=
# Dense embeddings: ollama (bge-m3) or hashing (the deterministic CI fake).
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
OLLAMA_HOST=http://localhost:11434
# Sparse (BM25) embeddings for hybrid search: fastembed | hashing.
# Unset or empty follows EMBEDDING_PROVIDER: hashing -> hashing, anything else -> fastembed.
SPARSE_PROVIDER=
SPARSE_MODEL=Qdrant/bm25
# Download cache for the fastembed sparse and reranker models.
FASTEMBED_CACHE=~/.cache/fastembed
# Dense and sparse top-k each, fused on the client (RRF, k=60) into the top-k hits.
RAG_TOP_K=40
# One total token budget for every pipeline, counted over the rendered prompt
# blocks, with no item limit (D-084). RAG_EVIDENCE_SLOTS and RAG_GRAPH_SLOTS
# are gone: a value left set is refused at start-up.
RAG_CONTEXT_TOKEN_BUDGET=2000
# Jaccard overlap at which a document chunk counts as a near-duplicate.
RAG_DEDUPE_THRESHOLD=0.85
# The one judge shared by A, B and C: cross_encoder or lexical (the CI judge,
# query-token overlap only). Unset means lexical when EMBEDDING_PROVIDER=hashing,
# else cross_encoder; set explicitly, it overrides that hashing default.
# BAAI/bge-reranker-v2-m3 downloads about 2.3 GB on first use (FASTEMBED_CACHE).
RERANK_PROVIDER=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# fake = deterministic CI generator; litellm = ADR-003 gateway.
GENERATION_PROVIDER=fake
GENERATION_MODEL=fake-answer-v1
GENERATION_TEMPERATURE=0
# Gateway base URL for litellm (for example http://localhost:11434 for Ollama).
# Unset with an ollama/ model means http://localhost:11434; OLLAMA_API_BASE is ignored.
# GENERATION_API_BASE=
# Completion cap, the same for A, B and C; room for models that spend tokens on
# hidden thinking. 1200 (v0.2.0) cut off answers in which the model wrote its
# reasoning inside the answer, so it is 4096 from D-096. With a prompt of about
# 3,400 tokens it fits a 32,768-token context (OLLAMA_CONTEXT_LENGTH).
GENERATION_MAX_TOKENS=4096
# Seconds one model gateway call may take (a positive number).
GENERATION_TIMEOUT_S=120
# Model family of GENERATION_MODEL (for example qwen); an official benchmark run requires it.
# GENERATION_MODEL_FAMILY=
# Quantisation of a local generation model (for example q4_K_M), recorded with each run.
# GENERATION_MODEL_QUANTISATION=
# Hidden reasoning of a thinking model: "default" leaves the provider unchanged,
# "off" asks it not to think: think=false for ollama/ and ollama_chat/ models,
# reasoning.enabled=false for openrouter/ models. Any other provider prefix is refused.
# A model that still reports reasoning tokens under "off" fails the call.
# A local thinking model can spend the whole token cap thinking and return an empty answer.
GENERATION_REASONING=default

# Benchmark judge (evaluator only). Smoke runs always use the fake judge; sweep
# and official runs call this model through the gateway, so they need litellm.
JUDGE_PROVIDER=fake
# Judge model in LiteLLM form (for example ollama/gemma4:31b).
JUDGE_MODEL=fake-judge-v1
# Model family of JUDGE_MODEL; an official run requires one that differs from GENERATION_MODEL_FAMILY.
# JUDGE_MODEL_FAMILY=
# Gateway base URL for the judge (for example http://localhost:11434 for Ollama).
# JUDGE_API_BASE=
# Judge sampling temperature; 0 keeps judgements as repeatable as the model allows.
JUDGE_TEMPERATURE=0
# Hidden reasoning of the judge model, as GENERATION_REASONING ("default" or "off";
# "off" needs an ollama/, ollama_chat/ or openrouter/ JUDGE_MODEL).
# The judge reply is capped at 300 tokens, so a thinking judge needs "off".
JUDGE_REASONING=default

# Second judge (evaluator only, D-100): re-judges a stored run's answers with the
# same prompt and parser (make second-judge RUN=<run id>). Read as the
# JUDGE_* keys are; it must call a model, so the provider is litellm.
# SECOND_JUDGE_PROVIDER=litellm
# Second judge model in LiteLLM form (for example ollama/muse-glimmer:latest).
# SECOND_JUDGE_MODEL=
# Its model family; required, and it must differ from both the answer model's and
# the first judge's family as the run records them (for example muse).
# SECOND_JUDGE_MODEL_FAMILY=
# Gateway base URL (for example http://localhost:11434 for Ollama).
# SECOND_JUDGE_API_BASE=
# Sampling temperature; unset means 0.
# SECOND_JUDGE_TEMPERATURE=0
# Hidden reasoning, as JUDGE_REASONING ("default" or "off"); a thinking model needs "off".
# SECOND_JUDGE_REASONING=off
# Reply limit in tokens, the one setting that may differ from the first judge
# (D-100 amendment); unset means the first judge's 300. Muse Glimmer spends hidden
# tokens even with reasoning off and replies empty at 300, so the run uses 2048.
# It bounds the reply only, not what the judge sees.
# SECOND_JUDGE_MAX_TOKENS=2048

# GraphRAG traversal (pipelines B and C)
GRAPH_DEPTH=2
GRAPH_MAX_NODES_PER_HOP=100
GRAPH_MAX_EDGES_PER_NODE_TYPE=4
GRAPH_MAX_TOTAL_NODES=200
# Records whose validity ended before this ISO date rank as superseded (empty: end of the dataset window).
GRAPH_REFERENCE_DATE=

# Presentation API (read once, when the application is created, not per request)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Benchmark runs the API publishes: the newest official summary.json in a run directory, else the newest of any kind.
# Unset means <repo>/data/evaluation/runs, where the benchmark CLI writes runs.
# BENCHMARK_DIR=
# SQLite run store; unset means <repo>/data/app.db.
# APP_DB_PATH=
# Runs the run store keeps (a positive integer).
RUN_RETENTION=500
# Seconds between server-sent-event heartbeats on a live run stream (a positive number).
SSE_HEARTBEAT_S=15
# Log verbosity of the JSON logs (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
